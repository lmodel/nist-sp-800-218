    dcterms:title "Recommended Criteria for Cybersecurity Labeling of Consumer Software (2022)" ;
    rdfs:seeAlso <https://www.nist.gov/itl/executive-order-improving-nations-cybersecurity> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "NIST's criteria for a cybersecurity label on consumer software." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#NTIASBOM> a owl:Class ;
