<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#CNCFSSCP> a owl:Class ;
    rdfs:label "CNCFSSCP" ;
    dcterms:title "Software Supply Chain Best Practices (2021)" ;
    rdfs:seeAlso <https://github.com/cncf/tag-security/tree/main/supply-chain-security/supply-chain-security-paper> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "The Cloud Native Computing Foundation's software supply chain paper." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#EO14028> a owl:Class ;
    rdfs:label "EO14028" ;
    dcterms:title "Executive Order 14028, Improving the Nation's Cybersecurity (2021)" ;
    rdfs:seeAlso <https://www.govinfo.gov/app/details/DCPD-202100401> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
