nist_sp_800_218:SsdfReferenceDocument a owl:Class ;
	rdfs:label "SsdfReferenceDocument" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-218> ;
	owl:unionOf _:c14n62 ;
	skos:definition "The established secure development documents that SP 800-218 maps its tasks to, by the labels its References list gives them. SP 800-218 cites each at the edition shown in its title." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> ;
	linkml:permissible_values nist_sp_800_218:SsdfReferenceDocument\#BSAFSS , nist_sp_800_218:SsdfReferenceDocument\#BSIMM , nist_sp_800_218:SsdfReferenceDocument\#CNCFSSCP , nist_sp_800_218:SsdfReferenceDocument\#EO14028 , nist_sp_800_218:SsdfReferenceDocument\#IDASOAR , nist_sp_800_218:SsdfReferenceDocument\#IEC62443 , nist_sp_800_218:SsdfReferenceDocument\#IR8397 , nist_sp_800_218:SsdfReferenceDocument\#ISO27034 , nist_sp_800_218:SsdfReferenceDocument\#ISO29147 , nist_sp_800_218:SsdfReferenceDocument\#ISO30111 , nist_sp_800_218:SsdfReferenceDocument\#MSSDL , nist_sp_800_218:SsdfReferenceDocument\#NISTCSF , nist_sp_800_218:SsdfReferenceDocument\#NISTLABEL , nist_sp_800_218:SsdfReferenceDocument\#NTIASBOM , nist_sp_800_218:SsdfReferenceDocument\#OWASPASVS , nist_sp_800_218:SsdfReferenceDocument\#OWASPMASVS , nist_sp_800_218:SsdfReferenceDocument\#OWASPSAMM , nist_sp_800_218:SsdfReferenceDocument\#OWASPSCVS , nist_sp_800_218:SsdfReferenceDocument\#PCISSLC , nist_sp_800_218:SsdfReferenceDocument\#SCAGILE , nist_sp_800_218:SsdfReferenceDocument\#SCFPSSD , nist_sp_800_218:SsdfReferenceDocument\#SCSIC , nist_sp_800_218:SsdfReferenceDocument\#SCTPC , nist_sp_800_218:SsdfReferenceDocument\#SCTTM , nist_sp_800_218:SsdfReferenceDocument\#SP800160 , nist_sp_800_218:SsdfReferenceDocument\#SP800161 , nist_sp_800_218:SsdfReferenceDocument\#SP800181 , nist_sp_800_218:SsdfReferenceDocument\#SP800216 , nist_sp_800_218:SsdfReferenceDocument\#SP80053 .
nist_sp_800_218:SsdfTask a owl:Class ;
	rdfs:label "SsdfTask" ;
	rdfs:seeAlso <https://csrc.nist.gov/projects/ssdf> ;
	rdfs:subClassOf _:c14n11 , _:c14n27 , _:c14n4 , _:c14n45 , _:c14n50 , _:c14n52 , _:c14n53 , _:c14n54 , _:c14n56 , _:c14n59 , _:c14n76 , _:c14n79 ;
	skos:broadMatch oscal:Control ;
	skos:definition "An action that may be needed to perform a practice, with notional examples of how it could be implemented and references to the documents whose practices it maps to." ;
	skos:exactMatch nist_sp_800_218:Task ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "What the practice group, practice, task or example says, in the words of whoever records it." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." .
nist_sp_800_218:example_id a owl:DatatypeProperty ;
	rdfs:label "example_id" ;
	skos:definition "The example's identifier in NIST's reference data, such as PO.1.1.1 for the first example of task PO.1.1." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:former_task_ids a owl:DatatypeProperty ;
	rdfs:label "former_task_ids" ;
	skos:definition "The identifiers the task had in an earlier SSDF version, which SP 800-218 notes beside the task after moving it, such as PW.3.1 for PO.1.3." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:group_id a owl:DatatypeProperty ;
	rdfs:label "group_id" ;
	skos:definition "The group's two letters, such as PO for Prepare the Organization." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:group_practices a owl:ObjectProperty ;
	rdfs:label "group_practices" ;
	skos:definition "The practices of the group. A knowledge bundle relates a practice to its group with isPartOf instead." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:implementation_examples a owl:ObjectProperty ;
	rdfs:label "implementation_examples" ;
	skos:definition "Notional examples of tools, processes or other methods that could help implement the task. SP 800-218 requires none of them and does not claim they are the only ways." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:mapped_items a owl:DatatypeProperty ;
	rdfs:label "mapped_items" ;
	skos:definition "The parts of the document the task maps to, as SP 800-218 lists them, such as the clause, control or activity identifiers SM.3, DE.1." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:practice_groups a owl:ObjectProperty ;
	rdfs:label "practice_groups" ;
	skos:definition "The practice groups, in the order SP 800-218 gives them." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:practice_id a owl:DatatypeProperty ;
	rdfs:label "practice_id" ;
	skos:definition "The practice's identifier, such as PO.1." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:practice_tasks a owl:ObjectProperty ;
	rdfs:label "practice_tasks" ;
	skos:definition "The tasks of the practice. A knowledge bundle relates a task to its practice with isPartOf instead." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:reference_document a owl:ObjectProperty ;
	rdfs:label "reference_document" ;
	skos:definition "The document the task maps to, by the label SP 800-218 gives it." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:ssdf_version a owl:DatatypeProperty ;
	rdfs:label "ssdf_version" ;
	skos:definition "The SSDF version, as NIST numbers it in the publication's title, such as 1.1." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:task_id a owl:DatatypeProperty ;
	rdfs:label "task_id" ;
	skos:definition "The task's identifier, such as PO.1.1." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:task_references a owl:ObjectProperty ;
	rdfs:label "task_references" ;
	skos:definition "The established secure development documents the task maps to, each with the parts of the document it maps to." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .
nist_sp_800_218:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "The name SP 800-218 gives the practice group or practice." ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." .
