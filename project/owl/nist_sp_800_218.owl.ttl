<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#IDASOAR> a owl:Class ;
    rdfs:label "IDASOAR" ;
    dcterms:title "State-of-the-Art Resources (SOAR) for Software Vulnerability Detection, Test, and Evaluation 2016" ;
