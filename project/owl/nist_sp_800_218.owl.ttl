@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix nist_sp_800_218: <https://w3id.org/lmodel/nist-sp-800-218/> .
@prefix oscal: <https://w3id.org/lmodel/oscal/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/nist-sp-800-218.owl.ttl> a owl:Ontology ;
    rdfs:label "nist_sp_800_218" ;
    dcterms:license "Apache-2.0" ;
    dcterms:source <https://doi.org/10.6028/NIST.SP.800-218> ;
    dcterms:title "Secure Software Development Framework (SSDF) version 1.1" ;
    pav:version "1.1.0" ;
    rdfs:seeAlso <https://csrc.nist.gov/projects/ssdf>,
        <https://csrc.nist.gov/pubs/sp/800/218/final>,
        <https://github.com/usnistgov/oscal-content/tree/v1.6.0/nist.gov/SP800-218/ver1>,
        <https://lmodel.github.io/nist-sp-800-218> ;
    skos:definition "A LinkML model of the Secure Software Development Framework (SSDF) version 1.1, which NIST Special Publication 800-218 recommends: its practice groups, practices and tasks, the notional implementation examples of each task, and the references that map each task to other secure software development documents." ;
    skos:note "NIST's catalog renders each practice group as an OSCAL group, each practice and task as an OSCAL control, each example as a part and each reference as a link. The broad_mappings name those lmodel/oscal classes.",
        "SP 800-218 is a work of the United States Government and is not subject to copyright in the United States. The descriptions here are this project's own words; NIST's text of each practice, task and example stays in the catalog copy.",
        "The version is the SSDF version that SP 800-218 defines, and source is the publication's digital object identifier. NIST's Cybersecurity and Privacy Reference Tool names the same version SP_800_218_1_1_0, and the catalog NIST publishes for it in usnistgov/oscal-content is copied to src/nist_sp_800_218/schema/oscal-content/ at the tag and commit in the annotations. scripts/check_upstream_release.py reads the same pins and reports when NIST publishes a newer edition or changes the catalog. The release tags are the schema's own versions." ;
    nist_sp_800_218:cprt_framework_version "SP_800_218_1_1_0" ;
    nist_sp_800_218:oscal_content_commit "f0de6d8d8c059d374f15e0ae07508d82e370fc1d" ;
    nist_sp_800_218:oscal_content_tag "v1.6.0" ;
    nist_sp_800_218:publication_date "2022-02" .

nist_sp_800_218:SsdfFramework a owl:Class ;
    rdfs:label "SsdfFramework" ;
    rdfs:seeAlso <https://csrc.nist.gov/pubs/sp/800/218/final> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_sp_800_218:ssdf_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:ssdf_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_sp_800_218:practice_groups ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[0-9]+\\.[0-9]+$" ] ) ] ;
            owl:onProperty nist_sp_800_218:ssdf_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_sp_800_218:SsdfPracticeGroup ;
            owl:onProperty nist_sp_800_218:practice_groups ] ;
    skos:definition "One version of the SSDF as a whole: its practice groups, each holding its practices and their tasks." ;
    skos:exactMatch nist_sp_800_218:Framework ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:SsdfImplementationExample a owl:Class ;
    rdfs:label "SsdfImplementationExample" ;
    rdfs:seeAlso <https://csrc.nist.gov/projects/ssdf> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_sp_800_218:example_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:example_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:example_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_sp_800_218:description ] ;
    skos:broadMatch oscal:Part ;
    skos:definition "A notional implementation example: one type of tool, process or other method that could help implement a task." ;
    skos:exactMatch nist_sp_800_218:ImplementationExample ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:SsdfPractice a owl:Class ;
    rdfs:label "SsdfPractice" ;
    rdfs:seeAlso <https://csrc.nist.gov/projects/ssdf> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_sp_800_218:practice_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_sp_800_218:SsdfTask ;
            owl:onProperty nist_sp_800_218:practice_tasks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_sp_800_218:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_sp_800_218:practice_tasks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:practice_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:practice_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_sp_800_218:title ] ;
    skos:broadMatch oscal:Control ;
    skos:definition "A secure software development practice: a named outcome with an identifier, a short explanation of what it is and why it helps, and the tasks that may be needed to achieve it." ;
    skos:exactMatch nist_sp_800_218:Practice ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:SsdfPracticeGroup a owl:Class ;
    rdfs:label "SsdfPracticeGroup" ;
    rdfs:seeAlso <https://csrc.nist.gov/projects/ssdf> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:group_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_sp_800_218:group_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_sp_800_218:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_sp_800_218:SsdfPractice ;
            owl:onProperty nist_sp_800_218:group_practices ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:group_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_sp_800_218:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_sp_800_218:group_practices ] ;
    skos:broadMatch oscal:Group ;
    skos:definition "One of the four groups SP 800-218 sorts its practices into: preparing the organization, protecting the software, producing well-secured software, and responding to vulnerabilities." ;
    skos:exactMatch nist_sp_800_218:PracticeGroup ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:SsdfReference a owl:Class ;
    rdfs:label "SsdfReference" ;
    rdfs:seeAlso <https://csrc.nist.gov/projects/ssdf> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_sp_800_218:SsdfReferenceDocument ;
            owl:onProperty nist_sp_800_218:reference_document ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_sp_800_218:reference_document ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:mapped_items ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:reference_document ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_sp_800_218:mapped_items ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "\\S" ] ) ] ;
            owl:onProperty nist_sp_800_218:mapped_items ] ;
    skos:broadMatch oscal:Link ;
    skos:definition "A pointer from a task to an established secure development document, and to the parts of that document the task maps to." ;
    skos:exactMatch nist_sp_800_218:Reference ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:SsdfTask a owl:Class ;
    rdfs:label "SsdfTask" ;
    rdfs:seeAlso <https://csrc.nist.gov/projects/ssdf> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_sp_800_218:SsdfImplementationExample ;
            owl:onProperty nist_sp_800_218:implementation_examples ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:task_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:former_task_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_sp_800_218:task_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_sp_800_218:implementation_examples ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_sp_800_218:SsdfReference ;
            owl:onProperty nist_sp_800_218:task_references ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_sp_800_218:task_references ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_sp_800_218:former_task_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_sp_800_218:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_sp_800_218:task_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_sp_800_218:description ] ;
    skos:broadMatch oscal:Control ;
    skos:definition "An action that may be needed to perform a practice, with notional examples of how it could be implemented and references to the documents whose practices it maps to." ;
    skos:exactMatch nist_sp_800_218:Task ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#BSAFSS> a owl:Class ;
    rdfs:label "BSAFSS" ;
