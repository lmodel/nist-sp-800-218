    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "BSA's framework for securing the software lifecycle." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#BSIMM> a owl:Class ;
    rdfs:label "BSIMM" ;
    dcterms:title "BSIMM12 2021 Foundations Report" ;
