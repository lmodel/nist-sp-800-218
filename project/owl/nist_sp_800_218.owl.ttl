    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "SAFECode's essential elements of a secure development lifecycle program." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#SCSIC> a owl:Class ;
    rdfs:label "SCSIC" ;
    dcterms:title "Software Integrity Controls: An Assurance-Based Approach to Minimizing Risks in the Software Supply Chain (2010)" ;
    rdfs:seeAlso <http://www.safecode.org/publication/SAFECode_Software_Integrity_Controls0610.pdf> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "SAFECode's controls for software integrity in the supply chain." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#SCTPC> a owl:Class ;
    rdfs:label "SCTPC" ;
    dcterms:title "Managing Security Risks Inherent in the Use of Third-Party Components (2017)" ;
    rdfs:seeAlso <https://www.safecode.org/wp-content/uploads/2017/05/SAFECode_TPC_Whitepaper.pdf> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "SAFECode's guidance on the security risks of third-party components." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#SCTTM> a owl:Class ;
    rdfs:label "SCTTM" ;
    dcterms:title "Tactical Threat Modeling (2017)" ;
    rdfs:seeAlso <https://www.safecode.org/wp-content/uploads/2017/05/SAFECode_TM_Whitepaper.pdf> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "SAFECode's guidance on threat modeling during development." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#SP800160> a owl:Class ;
    rdfs:label "SP800160" ;
    dcterms:title "NIST SP 800-160 Volume 1, Systems Security Engineering (2016, updated 2018)" ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-160v1> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "NIST's considerations for engineering trustworthy secure systems." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#SP800161> a owl:Class ;
    rdfs:label "SP800161" ;
    dcterms:title "NIST SP 800-161 Rev. 1 second draft, Cybersecurity Supply Chain Risk Management Practices (2021)" ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-161r1-draft2> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "NIST's supply chain risk management practices, at the draft SP 800-218 cites." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#SP800181> a owl:Class ;
    rdfs:label "SP800181" ;
    dcterms:title "NIST SP 800-181, NICE Cybersecurity Workforce Framework (2017)" ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-181> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "The workforce framework whose tasks, knowledge, skills and abilities SP 800-218 maps to." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#SP800216> a owl:Class ;
    rdfs:label "SP800216" ;
    dcterms:title "NIST SP 800-216 draft, Recommendations for Federal Vulnerability Disclosure Guidelines (2021)" ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-216-draft> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "NIST's recommendations for federal vulnerability disclosure, at the draft SP 800-218 cites." .

<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#SP80053> a owl:Class ;
    rdfs:label "SP80053" ;
    dcterms:title "NIST SP 800-53 Rev. 5, Security and Privacy Controls for Information Systems and Organizations (2020)" ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-53r5> ;
    rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
    skos:definition "NIST's catalog of security and privacy controls, which SP 800-218 maps to by control." .

nist_sp_800_218:former_task_ids a owl:DatatypeProperty ;
    rdfs:label "former_task_ids" ;
    skos:definition "The identifiers the task had in an earlier SSDF version, which SP 800-218 notes beside the task after moving it, such as PW.3.1 for PO.1.3." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:group_practices a owl:ObjectProperty ;
    rdfs:label "group_practices" ;
    skos:definition "The practices of the group. A knowledge bundle relates a practice to its group with isPartOf instead." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:implementation_examples a owl:ObjectProperty ;
    rdfs:label "implementation_examples" ;
    skos:definition "Notional examples of tools, processes or other methods that could help implement the task. SP 800-218 requires none of them and does not claim they are the only ways." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:practice_groups a owl:ObjectProperty ;
    rdfs:label "practice_groups" ;
    skos:definition "The practice groups, in the order SP 800-218 gives them." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:practice_tasks a owl:ObjectProperty ;
    rdfs:label "practice_tasks" ;
    skos:definition "The tasks of the practice. A knowledge bundle relates a task to its practice with isPartOf instead." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:task_references a owl:ObjectProperty ;
    rdfs:label "task_references" ;
    skos:definition "The established secure development documents the task maps to, each with the parts of the document it maps to." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:example_id a owl:DatatypeProperty ;
    rdfs:label "example_id" ;
    skos:definition "The example's identifier in NIST's reference data, such as PO.1.1.1 for the first example of task PO.1.1." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:group_id a owl:DatatypeProperty ;
    rdfs:label "group_id" ;
    skos:definition "The group's two letters, such as PO for Prepare the Organization." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:mapped_items a owl:DatatypeProperty ;
    rdfs:label "mapped_items" ;
    skos:definition "The parts of the document the task maps to, as SP 800-218 lists them, such as the clause, control or activity identifiers SM.3, DE.1." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:practice_id a owl:DatatypeProperty ;
    rdfs:label "practice_id" ;
    skos:definition "The practice's identifier, such as PO.1." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:reference_document a owl:ObjectProperty ;
    rdfs:label "reference_document" ;
    skos:definition "The document the task maps to, by the label SP 800-218 gives it." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:ssdf_version a owl:DatatypeProperty ;
    rdfs:label "ssdf_version" ;
    skos:definition "The SSDF version, as NIST numbers it in the publication's title, such as 1.1." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:task_id a owl:DatatypeProperty ;
    rdfs:label "task_id" ;
    skos:definition "The task's identifier, such as PO.1.1." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> .

nist_sp_800_218:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    skos:definition "The name SP 800-218 gives the practice group or practice." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> ;
    skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." .

nist_sp_800_218:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:definition "What the practice group, practice, task or example says, in the words of whoever records it." ;
    skos:inScheme <https://w3id.org/lmodel/nist-sp-800-218> ;
    skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." .

xsd:string a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(PO|PS|PW|RV)\\.[1-9][0-9]*\\.[1-9][0-9]*$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(PO|PS|PW|RV)\\.[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(PO|PS|PW|RV)\\.[1-9][0-9]*$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(PO|PS|PW|RV)$" ] ) ] .

