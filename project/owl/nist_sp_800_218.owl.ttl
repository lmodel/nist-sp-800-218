<https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument#NISTCSF> a owl:Class ;
    rdfs:label "NISTCSF" ;
    dcterms:title "Framework for Improving Critical Infrastructure Cybersecurity, version 1.1 (2018)" ;
