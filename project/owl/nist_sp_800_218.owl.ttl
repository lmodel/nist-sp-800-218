	a owl:Class ;
	rdfs:label "SP800160" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-160v1> ;
	rdfs:subClassOf nist_sp_800_218:SsdfReferenceDocument ;
