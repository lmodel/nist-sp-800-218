    }
  ],
  "default_prefix": "nist_sp_800_218",
  "default_range": "string",
  "types": [
    {
      "name": "ssdf_group_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-218/SsdfGroupIdentifier",
      "description": "The two letters that name one of the four practice groups.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-218",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(PO|PS|PW|RV)$",
      "@type": "TypeDefinition"
    },
    {
      "name": "ssdf_practice_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-218/SsdfPracticeIdentifier",
      "description": "A practice's identifier: its group's letters, a dot and the practice's number within the group, such as PO.1.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-218",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(PO|PS|PW|RV)\\.[1-9][0-9]*$",
      "@type": "TypeDefinition"
    },
    {
      "name": "ssdf_task_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-218/SsdfTaskIdentifier",
      "description": "A task's identifier: its practice's identifier, a dot and the task's number within the practice, such as PO.1.1.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-218",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(PO|PS|PW|RV)\\.[1-9][0-9]*\\.[1-9][0-9]*$",
      "@type": "TypeDefinition"
    },
    {
      "name": "ssdf_example_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-218/SsdfExampleIdentifier",
      "description": "The identifier NIST's reference data gives a notional implementation example: its task's identifier, a dot and the example's number, such as PO.1.1.1.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-218",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(PO|PS|PW|RV)\\.[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$",
      "@type": "TypeDefinition"
    },
