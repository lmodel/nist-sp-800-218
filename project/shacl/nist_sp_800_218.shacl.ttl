@prefix nist_sp_800_218: <https://w3id.org/lmodel/nist-sp-800-218/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nist_sp_800_218:Framework a sh:NodeShape ;
    rdfs:comment "One version of the SSDF as a whole: its practice groups, each holding its practices and their tasks." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class nist_sp_800_218:PracticeGroup ;
            sh:description "The practice groups, in the order SP 800-218 gives them." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path nist_sp_800_218:practice_groups ],
        [ sh:datatype xsd:string ;
            sh:description "The SSDF version, as NIST numbers it in the publication's title, such as 1.1." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path nist_sp_800_218:ssdf_version ;
            sh:pattern "^[0-9]+\\.[0-9]+$" ] ;
    sh:targetClass nist_sp_800_218:Framework .

nist_sp_800_218:ImplementationExample a sh:NodeShape ;
    rdfs:comment "A notional implementation example: one type of tool, process or other method that could help implement a task." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The example's identifier in NIST's reference data, such as PO.1.1.1 for the first example of task PO.1.1." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path nist_sp_800_218:example_id ;
            sh:pattern "^(PO|PS|PW|RV)\\.[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$" ],
        [ sh:datatype xsd:string ;
            sh:description "What the practice group, practice, task or example says, in the words of whoever records it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:description ] ;
    sh:targetClass nist_sp_800_218:ImplementationExample .

nist_sp_800_218:Practice a sh:NodeShape ;
    rdfs:comment "A secure software development practice: a named outcome with an identifier, a short explanation of what it is and why it helps, and the tasks that may be needed to achieve it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The practice's identifier, such as PO.1." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path nist_sp_800_218:practice_id ;
            sh:pattern "^(PO|PS|PW|RV)\\.[1-9][0-9]*$" ],
        [ sh:class nist_sp_800_218:Task ;
            sh:description "The tasks of the practice. A knowledge bundle relates a task to its practice with isPartOf instead." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path nist_sp_800_218:practice_tasks ],
        [ sh:datatype xsd:string ;
            sh:description "What the practice group, practice, task or example says, in the words of whoever records it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "The name SP 800-218 gives the practice group or practice." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ] ;
    sh:targetClass nist_sp_800_218:Practice .

nist_sp_800_218:PracticeGroup a sh:NodeShape ;
    rdfs:comment "One of the four groups SP 800-218 sorts its practices into: preparing the organization, protecting the software, producing well-secured software, and responding to vulnerabilities." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The group's two letters, such as PO for Prepare the Organization." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path nist_sp_800_218:group_id ;
            sh:pattern "^(PO|PS|PW|RV)$" ],
        [ sh:datatype xsd:string ;
            sh:description "The name SP 800-218 gives the practice group or practice." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "What the practice group, practice, task or example says, in the words of whoever records it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:description ],
        [ sh:class nist_sp_800_218:Practice ;
            sh:description "The practices of the group. A knowledge bundle relates a practice to its group with isPartOf instead." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path nist_sp_800_218:group_practices ] ;
    sh:targetClass nist_sp_800_218:PracticeGroup .

nist_sp_800_218:Reference a sh:NodeShape ;
    rdfs:comment "A pointer from a task to an established secure development document, and to the parts of that document the task maps to." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The document the task maps to, by the label SP 800-218 gives it." ;
            sh:in ( "BSAFSS" "BSIMM" "CNCFSSCP" "EO14028" "IDASOAR" "IEC62443" "IR8397" "ISO27034" "ISO29147" "ISO30111" "MSSDL" "NISTCSF" "NISTLABEL" "NTIASBOM" "OWASPASVS" "OWASPMASVS" "OWASPSAMM" "OWASPSCVS" "PCISSLC" "SCAGILE" "SCFPSSD" "SCSIC" "SCTPC" "SCTTM" "SP800160" "SP800161" "SP800181" "SP800216" "SP80053" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path nist_sp_800_218:reference_document ],
        [ sh:datatype xsd:string ;
            sh:description "The parts of the document the task maps to, as SP 800-218 lists them, such as the clause, control or activity identifiers SM.3, DE.1." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path nist_sp_800_218:mapped_items ;
            sh:pattern "\\S" ] ;
    sh:targetClass nist_sp_800_218:Reference .

nist_sp_800_218:Task a sh:NodeShape ;
    rdfs:comment "An action that may be needed to perform a practice, with notional examples of how it could be implemented and references to the documents whose practices it maps to." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The identifiers the task had in an earlier SSDF version, which SP 800-218 notes beside the task after moving it, such as PW.3.1 for PO.1.3." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path nist_sp_800_218:former_task_ids ;
            sh:pattern "^(PO|PS|PW|RV)\\.[1-9][0-9]*\\.[1-9][0-9]*$" ],
        [ sh:class nist_sp_800_218:ImplementationExample ;
            sh:description "Notional examples of tools, processes or other methods that could help implement the task. SP 800-218 requires none of them and does not claim they are the only ways." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path nist_sp_800_218:implementation_examples ],
        [ sh:class nist_sp_800_218:Reference ;
            sh:description "The established secure development documents the task maps to, each with the parts of the document it maps to." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path nist_sp_800_218:task_references ],
        [ sh:datatype xsd:string ;
            sh:description "What the practice group, practice, task or example says, in the words of whoever records it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:description ],
        [ sh:datatype xsd:string ;
            sh:description "The task's identifier, such as PO.1.1." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path nist_sp_800_218:task_id ;
            sh:pattern "^(PO|PS|PW|RV)\\.[1-9][0-9]*\\.[1-9][0-9]*$" ] ;
    sh:targetClass nist_sp_800_218:Task .

