<https://w3id.org/lmodel/nist-sp-800-218/nist_sp_800_218> dcterms:license "Apache-2.0" ;
	dcterms:source "https://doi.org/10.6028/NIST.SP.800-218"^^xsd:anyURI ;
	dcterms:title "Secure Software Development Framework (SSDF) version 1.1" ;
	pav:version "1.1.0" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://csrc.nist.gov/projects/ssdf"^^xsd:anyURI , "https://csrc.nist.gov/pubs/sp/800/218/final"^^xsd:anyURI , "https://github.com/usnistgov/oscal-content/tree/v1.6.0/nist.gov/SP800-218/ver1"^^xsd:anyURI , "https://lmodel.github.io/nist-sp-800-218"^^xsd:anyURI ;
	skos:note "NIST's catalog renders each practice group as an OSCAL group, each practice and task as an OSCAL control, each example as a part and each reference as a link. The broad_mappings name those lmodel/oscal classes." , "SP 800-218 is a work of the United States Government and is not subject to copyright in the United States. The descriptions here are this project's own words; NIST's text of each practice, task and example stays in the catalog copy." , "The version is the SSDF version that SP 800-218 defines, and source is the publication's digital object identifier. NIST's Cybersecurity and Privacy Reference Tool names the same version SP_800_218_1_1_0, and the catalog NIST publishes for it in usnistgov/oscal-content is copied to src/nist_sp_800_218/schema/oscal-content/ at the tag and commit in the annotations. scripts/check_upstream_release.py reads the same pins and reports when NIST publishes a newer edition or changes the catalog. The release tags are the schema's own versions." ;
	sh:declare _:c14n0 , _:c14n10 , _:c14n11 , _:c14n13 , _:c14n9 ;
	linkml:annotations _:c14n1 , _:c14n4 , _:c14n6 , _:c14n8 ;
	linkml:classes <https://w3id.org/lmodel/nist-sp-800-218/SsdfFramework> , <https://w3id.org/lmodel/nist-sp-800-218/SsdfImplementationExample> , <https://w3id.org/lmodel/nist-sp-800-218/SsdfPractice> , <https://w3id.org/lmodel/nist-sp-800-218/SsdfPracticeGroup> , <https://w3id.org/lmodel/nist-sp-800-218/SsdfReference> , <https://w3id.org/lmodel/nist-sp-800-218/SsdfTask> ;
	linkml:default_prefix "nist_sp_800_218" ;
	linkml:default_range <https://w3id.org/lmodel/nist-sp-800-218/string> ;
	linkml:description "A LinkML model of the Secure Software Development Framework (SSDF) version 1.1, which NIST Special Publication 800-218 recommends: its practice groups, practices and tasks, the notional implementation examples of each task, and the references that map each task to other secure software development documents." ;
	linkml:enums <https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument> ;
	linkml:id "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	linkml:imports "linkml:types"^^xsd:anyURI ;
	linkml:metamodel_version "1.12.0" ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-218/SsdfImplementationExample_description> , <https://w3id.org/lmodel/nist-sp-800-218/description> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfFramework__practice_groups> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfFramework__ssdf_version> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfImplementationExample__example_id> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfPracticeGroup__group_id> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfPracticeGroup__group_practices> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfPractice__practice_id> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfPractice__practice_tasks> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfReference__mapped_items> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfReference__reference_document> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfTask__former_task_ids> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfTask__implementation_examples> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfTask__task_id> , <https://w3id.org/lmodel/nist-sp-800-218/ssdfTask__task_references> , <https://w3id.org/lmodel/nist-sp-800-218/title> ;
	linkml:source_file "nist_sp_800_218.yaml" ;
	linkml:source_file_date "2026-11-07T02:04:02"^^xsd:dateTime ;
