	skos:prefLabel "group_practices" ;
	linkml:description "The practices of the group. A knowledge bundle relates a practice to its group with isPartOf instead." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-218/SsdfPracticeGroup> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-218/SsdfPracticeGroup> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/SsdfPractice> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-218/group_practices"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdfPractice__practice_id> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	skos:prefLabel "practice_id" ;
	linkml:description "The practice's identifier, such as PO.1." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-218/SsdfPractice> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-218/SsdfPractice> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/ssdf_practice_identifier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-218/practice_id"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdfPractice__practice_tasks> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	skos:prefLabel "practice_tasks" ;
	linkml:description "The tasks of the practice. A knowledge bundle relates a task to its practice with isPartOf instead." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-218/SsdfPractice> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-218/SsdfPractice> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/SsdfTask> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-218/practice_tasks"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdfReference__mapped_items> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	skos:prefLabel "mapped_items" ;
	linkml:description "The parts of the document the task maps to, as SP 800-218 lists them, such as the clause, control or activity identifiers SM.3, DE.1." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-218/SsdfReference> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-218/SsdfReference> ;
	linkml:pattern "^\\s*\\S" ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-218/mapped_items"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdfReference__reference_document> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	skos:prefLabel "reference_document" ;
	linkml:description "The document the task maps to, by the label SP 800-218 gives it." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-218/SsdfReference> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-218/SsdfReference> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/SsdfReferenceDocument> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-218/reference_document"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdfTask__former_task_ids> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	skos:prefLabel "former_task_ids" ;
	linkml:description "The identifiers the task had in an earlier SSDF version, which SP 800-218 notes beside the task after moving it, such as PW.3.1 for PO.1.3." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-218/SsdfTask> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-218/SsdfTask> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/ssdf_task_identifier> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-218/former_task_ids"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdfTask__implementation_examples> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	skos:prefLabel "implementation_examples" ;
	linkml:description "Notional examples of tools, processes or other methods that could help implement the task. SP 800-218 requires none of them and does not claim they are the only ways." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-218/SsdfTask> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-218/SsdfTask> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/SsdfImplementationExample> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-218/implementation_examples"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdfTask__task_id> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	skos:prefLabel "task_id" ;
	linkml:description "The task's identifier, such as PO.1.1." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-218/SsdfTask> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-218/SsdfTask> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/ssdf_task_identifier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-218/task_id"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdfTask__task_references> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	skos:prefLabel "task_references" ;
	linkml:description "The established secure development documents the task maps to, each with the parts of the document it maps to." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-218/SsdfTask> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-218/SsdfTask> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/SsdfReference> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-218/task_references"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdf_example_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-218/SsdfExampleIdentifier"^^xsd:anyURI ;
	linkml:description "The identifier NIST's reference data gives a notional implementation example: its task's identifier, a dot and the example's number, such as PO.1.1.1." ;
	linkml:pattern "^(PO|PS|PW|RV)\\.[1-9][0-9]*\\.[1-9][0-9]*\\.[1-9][0-9]*$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-218/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdf_group_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-218/SsdfGroupIdentifier"^^xsd:anyURI ;
	linkml:description "The two letters that name one of the four practice groups." ;
	linkml:pattern "^(PO|PS|PW|RV)$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-218/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdf_practice_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-218/SsdfPracticeIdentifier"^^xsd:anyURI ;
	linkml:description "A practice's identifier: its group's letters, a dot and the practice's number within the group, such as PO.1." ;
	linkml:pattern "^(PO|PS|PW|RV)\\.[1-9][0-9]*$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-218/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdf_task_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-218/SsdfTaskIdentifier"^^xsd:anyURI ;
	linkml:description "A task's identifier: its practice's identifier, a dot and the task's number within the practice, such as PO.1.1." ;
	linkml:pattern "^(PO|PS|PW|RV)\\.[1-9][0-9]*\\.[1-9][0-9]*$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-218/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/ssdf_version> a linkml:SlotDefinition ;
	linkml:description "The SSDF version, as NIST numbers it in the publication's title, such as 1.1." ;
	linkml:pattern "^[0-9]+\\.[0-9]+$" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-218/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/task_id> a linkml:SlotDefinition ;
	linkml:description "The task's identifier, such as PO.1.1." ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/ssdf_task_identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-218/task_references> a linkml:SlotDefinition ;
	linkml:description "The established secure development documents the task maps to, each with the parts of the document it maps to." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/SsdfReference> .
<https://w3id.org/lmodel/nist-sp-800-218/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/title> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-218"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/name"^^xsd:anyURI ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-218/title"^^xsd:anyURI ;
	linkml:description "The name SP 800-218 gives the practice group or practice." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-218/SsdfPractice> , <https://w3id.org/lmodel/nist-sp-800-218/SsdfPracticeGroup> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-218/SsdfPractice> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/string> ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/uri> dcterms:conformsTo "https://www.ietf.org/rfc/rfc3987.txt" ;
	a linkml:TypeDefinition ;
	skos:closeMatch "schema:URL"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node" ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/linkml/Uri"^^xsd:anyURI ;
	linkml:description "a complete URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/uriorcurie> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "URIorCURIE" ;
