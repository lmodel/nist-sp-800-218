	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-218/float> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"." ;
	skos:exactMatch "schema:Float"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/linkml/Float"^^xsd:anyURI ;
	linkml:description "A real number that conforms to the xsd:float specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#float"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/former_task_ids> a linkml:SlotDefinition ;
	linkml:description "The identifiers the task had in an earlier SSDF version, which SP 800-218 notes beside the task after moving it, such as PW.3.1 for PO.1.3." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/ssdf_task_identifier> .
<https://w3id.org/lmodel/nist-sp-800-218/group_id> a linkml:SlotDefinition ;
	linkml:description "The group's two letters, such as PO for Prepare the Organization." ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/ssdf_group_identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-218/group_practices> a linkml:SlotDefinition ;
	linkml:description "The practices of the group. A knowledge bundle relates a practice to its group with isPartOf instead." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/SsdfPractice> .
<https://w3id.org/lmodel/nist-sp-800-218/implementation_examples> a linkml:SlotDefinition ;
	linkml:description "Notional examples of tools, processes or other methods that could help implement the task. SP 800-218 requires none of them and does not claim they are the only ways." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-218/SsdfImplementationExample> .
