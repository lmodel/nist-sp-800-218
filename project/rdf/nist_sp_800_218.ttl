	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-218/mapped_items> a linkml:SlotDefinition ;
	linkml:description "The parts of the document the task maps to, as SP 800-218 lists them, such as the clause, control or activity identifiers SM.3, DE.1." ;
	linkml:pattern "^\\s*\\S" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-218/ncname> a linkml:TypeDefinition ;
